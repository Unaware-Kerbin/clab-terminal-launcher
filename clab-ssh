#!/usr/bin/env bash
# clab-ssh — discover Containerlab devices and open SSH sessions
#
# Linux/macOS entry point. See clab-ssh.ps1 for Windows.
#
# Usage:
#   ./clab-ssh
#   ./clab-ssh -t native
#   ./clab-ssh -t securecrt pe-1 ce-1
#   ./clab-ssh -l

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib"

# Host is never hardcoded — loaded from env, -H, or ~/.config/clab-ssh/config
CLAB_HOST="${CLAB_HOST:-}"
CLAB_USER="${CLAB_USER:-admin}"
SSH_USER="${SSH_USER:-}"
HOST_FROM_FLAG=0
SSH_USER_FROM_FLAG=0
LIST_ONLY=0
NO_JUMP=0
SAVE_DEVICE_CREDS=0
FORGET_DEVICE_CREDS=0
NO_DEVICE_CREDS=0
LAUNCHER="${CLAB_LAUNCHER:-}"
ASBRU_BIN="${ASBRU_BIN:-}"
ASBRU_CFG_DIR="${ASBRU_CFG_DIR:-$HOME/asbru-clab}"
SECURECRT_BIN="${SECURECRT_BIN:-}"
SECURECRT_JUMP_SESSION="${SECURECRT_JUMP_SESSION:-}"
PUTTY_BIN="${PUTTY_BIN:-}"
PUTTY_JUMP_SESSION="${PUTTY_JUMP_SESSION:-}"
TERMINAL_CMD="${TERMINAL_CMD:-}"
WIRESHARK_BIN="${WIRESHARK_BIN:-}"
CAPTURE_IFACE="${CAPTURE_IFACE:-}"
CAPTURE_FILTER="${CAPTURE_FILTER:-}"
CAPTURE_SUDO=0
EDGESHARK_PORT="${EDGESHARK_PORT:-5001}"
EDGESHARK_LOCAL_PORT="${EDGESHARK_LOCAL_PORT:-}"
EDGESHARK_INSTALL=0
EDGESHARK_NO_OPEN=0
EDGESHARK_DIRECT=0
EDGESHARK_TUNNEL=0

# Device credentials loaded once from the vault, shared across launchers.
DEVICE_USER=""
DEVICE_PASSWORD=""
DEVICE_CREDS_LOADED=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] [node ...]

Discover Containerlab devices and open SSH sessions.
Default device username: ${CLAB_USER}

Options:
  -h, --help              Show this help
  -l, --list              List running nodes only
  -H, --host HOST         Containerlab host (saved for next runs)
  -U, --ssh-user U        Linux username on the clab host
  -u, --user USER         Device SSH username (default: ${CLAB_USER})
  -t, --launcher NAME     asbru|securecrt|putty|native|wt|powershell|cmd|wireshark|edgeshark
  --list-launchers        Show which launchers are available here
  --no-jump               Connect directly (no jump host)
  --save-device-creds     Save/update encrypted device user+password (Ásbrú)
  --forget-device-creds   Delete local credential vault
  --no-device-creds       Skip vault; prompt for device passwords in Ásbrú
  --asbru PATH            Ásbrú binary
  --securecrt PATH        SecureCRT binary
  --putty PATH            PuTTY binary
  --jump-session NAME     SecureCRT/PuTTY saved jump session (optional)

Packet capture (-t wireshark):
  --wireshark PATH        Local Wireshark binary
  --capture-iface IFACE   Node interface to capture (e.g. e1-1, eth1); else prompt
  --capture-filter BPF    Optional tcpdump/BPF filter (e.g. 'tcp port 179')
  --capture-sudo          Run 'ip netns exec' via sudo on the clab host

Edgeshark (-t edgeshark): open the Edgeshark web UI (direct if reachable,
                          else forwarded through the jump host)
  --edgeshark-install     Deploy Edgeshark on the clab host first
  --edgeshark-direct      Force a direct connection to the host's port
  --edgeshark-tunnel      Force forwarding through the jump tunnel
  --edgeshark-port N      Edgeshark port on the clab host (default 5001)
  --edgeshark-local-port N  Local port for the tunnel (default: same, else auto)
  --no-open               Do not open the browser automatically

Environment:
  CLAB_HOST, CLAB_USER, SSH_USER, CLAB_LAUNCHER, CLAB_SSH_CONFIG
  ASBRU_BIN, ASBRU_CFG_DIR
  SECURECRT_BIN, SECURECRT_JUMP_SESSION
  PUTTY_BIN, PUTTY_JUMP_SESSION
  TERMINAL_CMD
  WIRESHARK_BIN, CAPTURE_IFACE, CAPTURE_FILTER

Local settings (never committed to git):
  ~/.config/clab-ssh/config              host / ssh user
  ~/.config/clab-ssh/credentials.vault   encrypted device credentials (Ásbrú)
EOF
}

NODES=()
LIST_LAUNCHERS=0

need_arg() {
  if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
    echo "Option $1 requires a value." >&2
    usage >&2
    exit 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -l|--list) LIST_ONLY=1; shift ;;
    --list-launchers) LIST_LAUNCHERS=1; shift ;;
    -H|--host) need_arg "$@"; CLAB_HOST="$2"; HOST_FROM_FLAG=1; shift 2 ;;
    -U|--ssh-user) need_arg "$@"; SSH_USER="$2"; SSH_USER_FROM_FLAG=1; shift 2 ;;
    -u|--user) need_arg "$@"; CLAB_USER="$2"; shift 2 ;;
    -t|--launcher) need_arg "$@"; LAUNCHER="$2"; shift 2 ;;
    --no-jump) NO_JUMP=1; shift ;;
    --save-device-creds) SAVE_DEVICE_CREDS=1; shift ;;
    --forget-device-creds) FORGET_DEVICE_CREDS=1; shift ;;
    --no-device-creds) NO_DEVICE_CREDS=1; shift ;;
    --asbru) need_arg "$@"; ASBRU_BIN="$2"; shift 2 ;;
    --securecrt) need_arg "$@"; SECURECRT_BIN="$2"; shift 2 ;;
    --putty) need_arg "$@"; PUTTY_BIN="$2"; shift 2 ;;
    --wireshark) need_arg "$@"; WIRESHARK_BIN="$2"; shift 2 ;;
    --capture-iface) need_arg "$@"; CAPTURE_IFACE="$2"; shift 2 ;;
    --capture-filter) need_arg "$@"; CAPTURE_FILTER="$2"; shift 2 ;;
    --capture-sudo) CAPTURE_SUDO=1; shift ;;
    --edgeshark-port) need_arg "$@"; EDGESHARK_PORT="$2"; shift 2 ;;
    --edgeshark-local-port) need_arg "$@"; EDGESHARK_LOCAL_PORT="$2"; shift 2 ;;
    --edgeshark-install) EDGESHARK_INSTALL=1; shift ;;
    --edgeshark-direct) EDGESHARK_DIRECT=1; shift ;;
    --edgeshark-tunnel) EDGESHARK_TUNNEL=1; shift ;;
    --no-open) EDGESHARK_NO_OPEN=1; shift ;;
    --jump-session)
      need_arg "$@"
      SECURECRT_JUMP_SESSION="$2"
      PUTTY_JUMP_SESSION="$2"
      shift 2
      ;;
    --) shift; NODES+=("$@"); break ;;
    -*) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    *) NODES+=("$1"); shift ;;
  esac
done

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

# Refuse to run as root/sudo. Local root is never needed (the jump SSH uses your
# login; remote netns/docker use *remote* sudo). Running under sudo makes the
# saved config in ~/.config/clab-ssh and the GUI hand-off (Wireshark/Edgeshark,
# Ásbrú) unusable by your normal desktop session — the classic "capture window
# closes instantly" symptom.
if [[ "${EUID:-$(id -u)}" -eq 0 && "${CLAB_ALLOW_ROOT:-0}" != "1" ]]; then
  echo "Refusing to run as root/sudo." >&2
  echo "Run clab-ssh as your normal desktop user — local root is not needed." >&2
  echo "  • jump / device SSH uses your own login" >&2
  echo "  • remote packet capture escalates with sudo on the clab host only" >&2
  echo "If a previous sudo run left root-owned files, fix them once with:" >&2
  echo "  sudo chown -R \"\$USER:\$USER\" ~/.config/clab-ssh" >&2
  echo "(Override only if you really know why: CLAB_ALLOW_ROOT=1)" >&2
  exit 1
fi

need python3

if [[ "$LIST_LAUNCHERS" -eq 1 ]]; then
  python3 "${LIB_DIR}/list_launchers.py"
  exit 0
fi

if [[ "$FORGET_DEVICE_CREDS" -eq 1 ]]; then
  python3 "${LIB_DIR}/credentials.py" forget
  echo "Device credential vault removed (if it existed)."
  # Allow combining with a normal launch; otherwise exit after forget-only.
  if [[ "$SAVE_DEVICE_CREDS" -eq 0 && -z "${LAUNCHER}" && "$LIST_ONLY" -eq 0 && ${#NODES[@]} -eq 0 ]]; then
    exit 0
  fi
fi

need ssh

# Resolve CLAB_HOST: env / -H / saved config / prompt (then persist)
if [[ -z "$CLAB_HOST" ]]; then
  CLAB_HOST="$(python3 "${LIB_DIR}/user_config.py" get CLAB_HOST)"
fi
if [[ -z "$CLAB_HOST" ]]; then
  read -r -p "Containerlab host IP/hostname: " CLAB_HOST
  CLAB_HOST="$(echo "$CLAB_HOST" | tr -d '[:space:]')"
  if [[ -z "$CLAB_HOST" ]]; then
    echo "Host is required." >&2
    exit 1
  fi
  python3 "${LIB_DIR}/user_config.py" set CLAB_HOST "$CLAB_HOST" >/dev/null
  echo "Saved host to $(python3 "${LIB_DIR}/user_config.py" path)"
elif [[ "$HOST_FROM_FLAG" -eq 1 ]]; then
  python3 "${LIB_DIR}/user_config.py" set CLAB_HOST "$CLAB_HOST" >/dev/null
fi

# Resolve SSH_USER: env / -U / saved config / prompt (then persist)
if [[ -z "$SSH_USER" ]]; then
  SSH_USER="$(python3 "${LIB_DIR}/user_config.py" get SSH_USER)"
fi
if [[ -z "$SSH_USER" ]]; then
  default_user="$(whoami)"
  read -r -p "Username for Containerlab host ${CLAB_HOST} [${default_user}]: " SSH_USER
  SSH_USER="${SSH_USER:-$default_user}"
  python3 "${LIB_DIR}/user_config.py" set SSH_USER "$SSH_USER" >/dev/null
elif [[ "$SSH_USER_FROM_FLAG" -eq 1 ]]; then
  python3 "${LIB_DIR}/user_config.py" set SSH_USER "$SSH_USER" >/dev/null
fi

JUMP_TARGET="${SSH_USER}@${CLAB_HOST}"
CONTROL_PATH=""
SOCKS_PORT=""

# Open one jump tunnel (password once): ControlMaster for discovery + SOCKS for Ásbrú.
open_jump_master() {
  local cm_dir askpass jump_password known_hosts
  cm_dir="${HOME}/.config/clab-ssh/ssh-cm"
  mkdir -p "$cm_dir"
  chmod 700 "$cm_dir" 2>/dev/null || true
  CONTROL_PATH="${cm_dir}/control"
  known_hosts="${HOME}/.config/clab-ssh/known_hosts"
  mkdir -p "$(dirname "$known_hosts")"
  touch "$known_hosts"
  chmod 600 "$known_hosts" 2>/dev/null || true

  # Reuse an already-open master if one is alive, so concurrent clab-ssh runs
  # (e.g. a Wireshark capture AND a terminal session) share a single tunnel
  # instead of tearing each other's down. The SOCKS port is stashed alongside
  # the socket so a reusing run can still hand it to Ásbrú.
  local socks_file="${cm_dir}/socks_port"
  if ssh -O check -S "$CONTROL_PATH" "$JUMP_TARGET" >/dev/null 2>&1; then
    local saved_port=""
    [[ -f "$socks_file" ]] && saved_port="$(cat "$socks_file" 2>/dev/null)"
    if [[ -n "$saved_port" ]]; then
      SOCKS_PORT="$saved_port"
      echo "Reusing existing jump tunnel (SOCKS 127.0.0.1:${SOCKS_PORT}); no password needed."
      return 0
    fi
    # Live master but unknown SOCKS port (pre-existing/old tunnel): refresh it
    # so we have a port to advertise. Rare and one-time.
    echo "Existing jump tunnel found without a known SOCKS port; refreshing it."
  fi

  ssh -O exit -S "$CONTROL_PATH" "$JUMP_TARGET" >/dev/null 2>&1 || true
  rm -f "$CONTROL_PATH" "$socks_file"

  SOCKS_PORT="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"

  echo
  echo "Jump host password for ${JUMP_TARGET} (once for this run):"
  read -r -s -p "Password: " jump_password
  echo
  if [[ -z "$jump_password" ]]; then
    echo "Jump password is required." >&2
    exit 1
  fi

  askpass="$(mktemp)"
  cat >"$askpass" <<'ASK'
#!/bin/sh
printf '%s\n' "$CLAB_JUMP_PASSWORD"
ASK
  chmod 700 "$askpass"
  export CLAB_JUMP_PASSWORD="$jump_password"
  export SSH_ASKPASS="$askpass"
  export SSH_ASKPASS_REQUIRE=force

  # -D = local SOCKS for Ásbrú (snap cannot use host ControlMaster sockets)
  if ! ssh -fN -M -S "$CONTROL_PATH" \
    -D "127.0.0.1:${SOCKS_PORT}" \
    -o StrictHostKeyChecking=accept-new \
    -o "UserKnownHostsFile=${known_hosts}" \
    -o GlobalKnownHostsFile=/dev/null \
    -o UpdateHostkeys=no \
    -o NumberOfPasswordPrompts=1 \
    -o PreferredAuthentications=password,keyboard-interactive \
    "$JUMP_TARGET"; then
    unset CLAB_JUMP_PASSWORD SSH_ASKPASS SSH_ASKPASS_REQUIRE
    rm -f "$askpass"
    echo "Failed to open jump tunnel to ${JUMP_TARGET}." >&2
    exit 1
  fi
  unset CLAB_JUMP_PASSWORD SSH_ASKPASS SSH_ASKPASS_REQUIRE
  rm -f "$askpass"
  jump_password=""
  # Record the SOCKS port so later concurrent runs can reuse this master.
  printf '%s\n' "$SOCKS_PORT" >"$socks_file" 2>/dev/null || true
  chmod 600 "$socks_file" 2>/dev/null || true
  echo "Jump tunnel ready (SOCKS 127.0.0.1:${SOCKS_PORT})."
}

if [[ "$NO_JUMP" -eq 0 ]]; then
  open_jump_master
fi

DISCOVER_ARGS=(--host "$CLAB_HOST" --ssh-user "$SSH_USER" --format jsonl)
[[ -n "$CONTROL_PATH" ]] && DISCOVER_ARGS+=(--control-path "$CONTROL_PATH")
for f in "${NODES[@]+"${NODES[@]}"}"; do
  [[ -n "$f" ]] && DISCOVER_ARGS+=(--filter "$f")
done

mapfile -t DEVICE_JSON_LINES < <(python3 "${LIB_DIR}/discover.py" "${DISCOVER_ARGS[@]}") || {
  echo "Discovery failed." >&2
  exit 1
}

if [[ ${#DEVICE_JSON_LINES[@]} -eq 0 ]]; then
  echo "No running nodes with management IPv4 found." >&2
  exit 1
fi

print_table() {
  printf "%-28s %-16s %-28s %s\n" "NAME" "SHORT" "KIND" "MGMT IPv4"
  printf "%-28s %-16s %-28s %s\n" "----" "-----" "----" "--------"
  for line in "${DEVICE_JSON_LINES[@]}"; do
    python3 -c 'import json,sys; d=json.loads(sys.argv[1]); print("%-28s %-16s %-28s %s" % (d["long"], d["short"], d["kind"], d["ip"]))' "$line"
  done
}

echo
print_table
echo

if [[ "$LIST_ONLY" -eq 1 ]]; then
  exit 0
fi

DEVICES_JSON="$(printf '%s\n' "${DEVICE_JSON_LINES[@]}" | python3 -c 'import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin if l.strip()]))')"

detect_default_launcher() {
  local uname_s
  uname_s="$(uname -s 2>/dev/null || echo unknown)"
  case "$uname_s" in
    Linux*)
      if command -v asbru >/dev/null 2>&1 || command -v asbru-cm >/dev/null 2>&1; then
        echo asbru
      else
        echo native
      fi
      ;;
    Darwin*)
      echo native
      ;;
    *)
      echo native
      ;;
  esac
}

if [[ -z "$LAUNCHER" ]]; then
  LAUNCHER="$(detect_default_launcher)"
fi

LAUNCHER="$(echo "$LAUNCHER" | tr '[:upper:]' '[:lower:]')"

resolve_asbru() {
  if [[ -n "$ASBRU_BIN" ]]; then
    return 0
  fi
  if command -v asbru >/dev/null 2>&1; then
    ASBRU_BIN="$(command -v asbru)"
  elif command -v asbru-cm >/dev/null 2>&1; then
    ASBRU_BIN="$(command -v asbru-cm)"
  else
    echo "Ásbrú not found. Install asbru-cm or set ASBRU_BIN / use -t native." >&2
    exit 1
  fi
}

resolve_securecrt() {
  if [[ -n "$SECURECRT_BIN" ]]; then
    return 0
  fi
  local c
  for c in securecrt SecureCRT SecureCRT.exe \
    "/Applications/SecureCRT.app/Contents/MacOS/SecureCRT" \
    "/mnt/c/Program Files/VanDyke Software/SecureCRT/SecureCRT.exe" \
    "/mnt/c/Program Files (x86)/VanDyke Software/SecureCRT/SecureCRT.exe"; do
    if command -v "$c" >/dev/null 2>&1; then
      SECURECRT_BIN="$(command -v "$c")"
      return 0
    fi
    if [[ -x "$c" ]]; then
      SECURECRT_BIN="$c"
      return 0
    fi
  done
  echo "SecureCRT not found. Set SECURECRT_BIN or --securecrt." >&2
  exit 1
}

resolve_putty() {
  if [[ -n "$PUTTY_BIN" ]]; then
    return 0
  fi
  local c
  for c in putty putty.exe \
    "/mnt/c/Program Files/PuTTY/putty.exe" \
    "/mnt/c/Program Files (x86)/PuTTY/putty.exe"; do
    if command -v "$c" >/dev/null 2>&1; then
      PUTTY_BIN="$(command -v "$c")"
      return 0
    fi
    if [[ -x "$c" ]]; then
      PUTTY_BIN="$c"
      return 0
    fi
  done
  echo "PuTTY not found. Set PUTTY_BIN or --putty." >&2
  exit 1
}

ssh_argv_for() {
  # prints ssh args as a single shell-quoted string suitable for -x / -Command
  #   $1 = device IP
  #   $2 = reuse_master (1 = reuse the already-open jump ControlMaster via a
  #        ProxyCommand so the jump password is entered only once; 0 = plain -J).
  #        Use 0 for Windows ssh.exe (wt/powershell/cmd), which cannot use a unix
  #        control socket.
  local ip="$1"
  local reuse_master="${2:-0}"
  local args=(ssh -o StrictHostKeyChecking=accept-new -l "$CLAB_USER")
  if [[ "$NO_JUMP" -eq 0 ]]; then
    if [[ "$reuse_master" -eq 1 && -n "$CONTROL_PATH" && -S "$CONTROL_PATH" ]]; then
      args+=(-o "ProxyCommand=ssh -o ControlPath=${CONTROL_PATH} -o ControlMaster=no -W %h:%p ${JUMP_TARGET}")
    else
      args+=(-J "$JUMP_TARGET")
    fi
  fi
  args+=("$ip")
  python3 -c 'import shlex,sys; print(shlex.join(sys.argv[1:]))' "${args[@]}"
}

launch_native_one() {
  local name="$1" ip="$2"
  local force_wt="${3:-0}"
  local ssh_cmd
  # Linux/macOS terminals run native ssh, which can reuse the jump ControlMaster
  # (single jump password). The wt.exe/powershell.exe fallbacks below build their
  # own -J command since they invoke Windows ssh.exe.
  ssh_cmd="$(ssh_argv_for "$ip" 1)"
  # Autofill the device password via sshpass -f (file-based; not exposed in ps).
  # Only for the native ssh path — the Windows-ssh fallbacks below can't use it.
  if [[ "$force_wt" -ne 1 && -n "$DEVICE_PASSWORD" ]] && command -v sshpass >/dev/null 2>&1; then
    local _pwf
    if _pwf="$(mk_pw_file "$DEVICE_PASSWORD")"; then
      ssh_cmd="sshpass -f $(printf '%q' "$_pwf") ${ssh_cmd}"
    fi
  fi
  echo "→ ${name} (${ip}) via native ssh"

  if [[ -n "$TERMINAL_CMD" ]]; then
    # shellcheck disable=SC2086
    eval "$TERMINAL_CMD" "$ssh_cmd" &
    return 0
  fi

  if [[ "$force_wt" -eq 1 ]]; then
    if command -v wt.exe >/dev/null 2>&1; then
      wt.exe new-tab --title "clab:${name}" ssh -o StrictHostKeyChecking=accept-new -l "$CLAB_USER" \
        $([[ "$NO_JUMP" -eq 0 ]] && printf '%s %s' -J "$JUMP_TARGET") "$ip" &
      return 0
    fi
    if command -v wt >/dev/null 2>&1; then
      wt new-tab --title "clab:${name}" ssh -o StrictHostKeyChecking=accept-new -l "$CLAB_USER" \
        $([[ "$NO_JUMP" -eq 0 ]] && printf '%s %s' -J "$JUMP_TARGET") "$ip" &
      return 0
    fi
    echo "Windows Terminal (wt) not found; falling back to native." >&2
  fi

  if command -v ptyxis >/dev/null 2>&1; then
    ptyxis --new-window --title "clab:${name}" -x "$ssh_cmd" >/dev/null 2>&1 &
  elif command -v gnome-terminal >/dev/null 2>&1; then
    gnome-terminal --title="clab:${name}" -- bash -lc "$ssh_cmd; echo; read -r -p 'Press Enter...'" &
  elif command -v konsole >/dev/null 2>&1; then
    konsole -p tabtitle="clab:${name}" -e bash -lc "$ssh_cmd" &
  elif command -v xfce4-terminal >/dev/null 2>&1; then
    xfce4-terminal --title="clab:${name}" -e "bash -lc $(printf '%q' "$ssh_cmd")" &
  elif command -v mate-terminal >/dev/null 2>&1; then
    mate-terminal --title="clab:${name}" -e "bash -lc $(printf '%q' "$ssh_cmd")" &
  elif command -v kitty >/dev/null 2>&1; then
    kitty --title "clab:${name}" bash -lc "$ssh_cmd" &
  elif command -v alacritty >/dev/null 2>&1; then
    alacritty --title "clab:${name}" -e bash -lc "$ssh_cmd" &
  elif command -v x-terminal-emulator >/dev/null 2>&1; then
    x-terminal-emulator -T "clab:${name}" -e bash -lc "$ssh_cmd; echo; read -r -p 'Press Enter...'" &
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    if [[ -d "/Applications/iTerm.app" ]]; then
      osascript <<EOF &
tell application "iTerm"
  create window with default profile
  tell current session of current window
    write text "$ssh_cmd"
  end tell
  activate
end tell
EOF
    else
      osascript <<EOF &
tell application "Terminal"
  do script "$ssh_cmd"
  activate
end tell
EOF
    fi
  elif command -v wt.exe >/dev/null 2>&1; then
    wt.exe new-tab --title "clab:${name}" ssh -o StrictHostKeyChecking=accept-new -l "$CLAB_USER" \
      $([[ "$NO_JUMP" -eq 0 ]] && printf '%s %s' -J "$JUMP_TARGET") "$ip" &
  elif command -v powershell.exe >/dev/null 2>&1; then
    local ssh_args_json
    ssh_args_json="$(python3 -c 'import json,sys; print(",".join(json.dumps(a) for a in sys.argv[1:]))' \
      -o StrictHostKeyChecking=accept-new -l "$CLAB_USER" \
      $([[ "$NO_JUMP" -eq 0 ]] && echo -J "$JUMP_TARGET") "$ip")"
    powershell.exe -NoProfile -Command "Start-Process ssh -ArgumentList @($ssh_args_json)" &
  elif command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -Command "Start-Process -FilePath ssh -ArgumentList @($(python3 -c 'import json,sys; print(",".join(json.dumps(a) for a in sys.argv[1:]))' -o StrictHostKeyChecking=accept-new -l "$CLAB_USER" $([[ "$NO_JUMP" -eq 0 ]] && echo -J "$JUMP_TARGET") "$ip"))" &
  else
    echo "  (no GUI terminal found — opening in current shell)"
    # shellcheck disable=SC2086
    eval "$ssh_cmd" || true
  fi
}

# Load device credentials from the local encrypted vault into DEVICE_USER /
# DEVICE_PASSWORD (may prompt to create/unlock). Shared by every launcher that
# can autofill. Honors --no-device-creds / --save-device-creds. Runs at most once.
load_device_credentials() {
  [[ "$DEVICE_CREDS_LOADED" -eq 1 ]] && return 0
  DEVICE_CREDS_LOADED=1
  DEVICE_USER="$CLAB_USER"
  DEVICE_PASSWORD=""
  local vault_json vault_exists ans

  # credentials.py prints prompts on stderr; stdout is a single JSON object.
  apply_vault_json() {
    local raw="$1"
    local parsed
    parsed="$(printf '%s' "$raw" | python3 -c '
import json, sys
raw = sys.stdin.read()
for line in reversed(raw.splitlines()):
    line = line.strip()
    if line.startswith("{") and line.endswith("}"):
        d = json.loads(line)
        print(d["device_user"])
        print(d["device_password"])
        raise SystemExit(0)
raise SystemExit("no JSON credential payload on stdout")
')" || return 1
    DEVICE_USER="$(printf '%s\n' "$parsed" | sed -n '1p')"
    DEVICE_PASSWORD="$(printf '%s\n' "$parsed" | sed -n '2p')"
  }

  if [[ "$NO_DEVICE_CREDS" -eq 1 ]]; then
    echo "Skipping device credential vault (--no-device-creds)."
  else
    vault_exists="$(python3 "${LIB_DIR}/credentials.py" exists)"
    if [[ "$SAVE_DEVICE_CREDS" -eq 1 || "$vault_exists" == "0" ]]; then
      if [[ "$SAVE_DEVICE_CREDS" -eq 0 ]]; then
        read -r -p "Save encrypted device credentials for autofill? [Y/n]: " ans
        ans="$(echo "${ans:-Y}" | tr '[:upper:]' '[:lower:]')"
        if [[ "$ans" != "y" && "$ans" != "yes" ]]; then
          echo "Continuing without saved device credentials (you'll be prompted)."
          vault_exists="skip"
        fi
      fi
      if [[ "$vault_exists" != "skip" ]]; then
        if vault_json="$(CLAB_USER="$CLAB_USER" python3 "${LIB_DIR}/credentials.py" set)" \
          && apply_vault_json "$vault_json"; then
          :
        else
          echo "Could not save/parse device credentials; continuing without autofill." >&2
          DEVICE_PASSWORD=""
        fi
      fi
    else
      if vault_json="$(python3 "${LIB_DIR}/credentials.py" get)" \
        && apply_vault_json "$vault_json"; then
        :
      else
        echo "Could not unlock credential vault." >&2
        read -r -p "Re-save credentials? [y/N]: " ans
        ans="$(echo "${ans:-N}" | tr '[:upper:]' '[:lower:]')"
        if [[ "$ans" == "y" || "$ans" == "yes" ]]; then
          if vault_json="$(CLAB_USER="$CLAB_USER" python3 "${LIB_DIR}/credentials.py" set)" \
            && apply_vault_json "$vault_json"; then
            :
          else
            echo "Continuing without autofill." >&2
            DEVICE_PASSWORD=""
          fi
        else
          echo "Continuing without autofill." >&2
        fi
      fi
    fi
  fi

  [[ -n "$DEVICE_USER" ]] && CLAB_USER="$DEVICE_USER"
  vault_json=""
  return 0
}

# Write a password to a private temp file (0600) for sshpass -f / putty -pwfile.
# Avoids exposing the password in the process list. The file is shredded a few
# seconds after launch, once the client has read it. Prints the file path.
mk_pw_file() {
  local pw="$1" f
  [[ -z "$pw" ]] && return 1
  f="$(mktemp "${TMPDIR:-/tmp}/clab-pw.XXXXXX")" || return 1
  chmod 600 "$f" 2>/dev/null || true
  printf '%s\n' "$pw" >"$f"
  ( sleep 10; shred -u "$f" 2>/dev/null || rm -f "$f" ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
  printf '%s' "$f"
}

launch_asbru() {
  resolve_asbru

  load_device_credentials
  local device_user="$DEVICE_USER"
  local device_password="$DEVICE_PASSWORD"

  # Reuse the jump tunnel opened before discovery (SOCKS for Ásbrú snap).
  local control_path="${CONTROL_PATH:-}"
  local socks_port="${SOCKS_PORT:-}"
  if [[ "$NO_JUMP" -eq 0 && -z "$socks_port" ]]; then
    echo "No jump tunnel available; opening one now."
    open_jump_master
    control_path="${CONTROL_PATH:-}"
    socks_port="${SOCKS_PORT:-}"
  fi
  if [[ "$NO_JUMP" -eq 0 && -z "$socks_port" ]]; then
    echo "Jump SOCKS tunnel is required for Ásbrú." >&2
    exit 1
  fi

  mkdir -p "$ASBRU_CFG_DIR"
  touch "${ASBRU_CFG_DIR}/known_hosts"
  chmod 600 "${ASBRU_CFG_DIR}/known_hosts" 2>/dev/null || true

  local uuids
  local extra=()
  [[ "$NO_JUMP" -eq 1 ]] && extra+=(--no-jump)
  [[ -n "$socks_port" ]] && extra+=(--socks-port "$socks_port")

  if [[ -n "$device_password" ]]; then
    export CLAB_DEVICE_PASSWORD="$device_password"
  else
    unset CLAB_DEVICE_PASSWORD || true
  fi

  uuids="$(python3 "${LIB_DIR}/asbru_config.py" \
    --cfg-dir "$ASBRU_CFG_DIR" \
    --host "$CLAB_HOST" \
    --ssh-user "$SSH_USER" \
    --device-user "$device_user" \
    --devices-json "$DEVICES_JSON" \
    "${extra[@]+"${extra[@]}"}")"
  unset CLAB_DEVICE_PASSWORD || true
  device_password=""
  vault_json=""

  uuids="$(echo "$uuids" | tr -d '\r')"
  uuids="$(printf '%s\n' "$uuids" | awk 'NF{line=$0} END{print line}')"
  if [[ -z "$uuids" ]]; then
    echo "Failed to build Ásbrú connections." >&2
    exit 1
  fi

  local args=(--config-dir="$ASBRU_CFG_DIR" --no-splash)
  local u
  for u in $uuids; do
    args+=(--start-uuid="$u")
  done

  echo "Launching Ásbrú (${#DEVICE_JSON_LINES[@]} session(s))..."
  if pgrep -f '[a]sbru-cm|/snap/asbru/.*/bin/asbru' >/dev/null 2>&1; then
    echo "Ásbrú is already running — restarting with clab connections..."
    pkill -f '[a]sbru-cm|/snap/asbru/.*/bin/asbru' 2>/dev/null || true
    for _ in $(seq 1 20); do
      pgrep -f '[a]sbru-cm|/snap/asbru/.*/bin/asbru' >/dev/null 2>&1 || break
      sleep 0.25
    done
    sleep 0.5
  fi

  "$ASBRU_BIN" "${args[@]}" &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  sleep 1.5
  if kill -0 "$pid" 2>/dev/null; then
    echo "Ásbrú started (pid $pid)."
    if [[ -n "$socks_port" ]]; then
      echo "Jump SOCKS: 127.0.0.1:${socks_port} (keep this tunnel up while using Ásbrú)."
    fi
  else
    echo "Ásbrú exited immediately. Try: $ASBRU_BIN ${args[*]}" >&2
    [[ -n "$control_path" ]] && ssh -O exit -S "$control_path" "$JUMP_TARGET" 2>/dev/null || true
    exit 1
  fi
}

launch_securecrt() {
  resolve_securecrt
  # Without a saved jump session, fall back to OpenSSH ProxyJump in the OS terminal
  # so sessions still work on every platform.
  if [[ "$NO_JUMP" -eq 0 && -z "$SECURECRT_JUMP_SESSION" ]]; then
    echo "Note: no SecureCRT jump session set; using OpenSSH ProxyJump (native) for connectivity." >&2
    echo "Set --jump-session / SECURECRT_JUMP_SESSION to use SecureCRT's firewall jump." >&2
    launch_native
    return 0
  fi
  local line name ip
  for line in "${DEVICE_JSON_LINES[@]}"; do
    name="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["short"])' "$line")"
    ip="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["ip"])' "$line")"
    echo "→ ${name} (${ip}) via SecureCRT"
    local cmd=("$SECURECRT_BIN" /T /ssh2 "$ip" /l "$CLAB_USER" /P 22 /accepthostkeys)
    if [[ "$NO_JUMP" -eq 0 ]]; then
      cmd=( "$SECURECRT_BIN" /T "/firewall=Session:${SECURECRT_JUMP_SESSION}" /ssh2 "$ip" /l "$CLAB_USER" /P 22 /accepthostkeys )
    fi
    "${cmd[@]}" >/dev/null 2>&1 &
    sleep 0.15
  done
  echo "Launched ${#DEVICE_JSON_LINES[@]} SecureCRT session(s)."
}

launch_putty() {
  resolve_putty
  local line name ip
  local use_proxycmd=0
  if [[ "$NO_JUMP" -eq 0 && -z "$PUTTY_JUMP_SESSION" ]]; then
    echo "Note: no PuTTY jump session set; using OpenSSH ProxyCommand (-proxycmd)." >&2
    use_proxycmd=1
  fi
  # Password autofill uses PuTTY's -pwfile (0.77+), which reads the password from
  # a private file rather than argv. Windows putty.exe can't read a WSL/Unix path,
  # so autofill is limited to native (non-.exe) PuTTY builds.
  local putty_autofill=0
  if [[ "$PUTTY_BIN" != *.exe ]]; then
    load_device_credentials
    if [[ -n "$DEVICE_PASSWORD" ]]; then
      putty_autofill=1
      echo "Device password autofill: enabled (PuTTY -pwfile; requires PuTTY 0.77+)."
    fi
  fi
  for line in "${DEVICE_JSON_LINES[@]}"; do
    name="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["short"])' "$line")"
    ip="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["ip"])' "$line")"
    echo "→ ${name} (${ip}) via PuTTY"
    local cmd=("$PUTTY_BIN" -ssh -P 22 -l "$CLAB_USER" -loghost "$name")
    if [[ "$putty_autofill" -eq 1 ]]; then
      local _pwf
      if _pwf="$(mk_pw_file "$DEVICE_PASSWORD")"; then
        cmd+=(-pwfile "$_pwf")
      fi
    fi
    if [[ "$NO_JUMP" -eq 0 ]]; then
      if [[ "$use_proxycmd" -eq 1 ]]; then
        # Works on Windows/WSL/Linux whenever ssh is available — no saved session required.
        # On Linux/macOS PuTTY the proxy ssh can reuse our jump ControlMaster (no extra
        # jump password). Windows putty.exe invokes Windows ssh.exe, which rejects
        # ControlPath, so keep the plain form there.
        if [[ -n "$CONTROL_PATH" && -S "$CONTROL_PATH" && "$PUTTY_BIN" != *.exe ]]; then
          cmd+=(-proxycmd "ssh -o ControlPath=${CONTROL_PATH} -o ControlMaster=no -W %host:%port -o StrictHostKeyChecking=accept-new ${JUMP_TARGET}")
        else
          cmd+=(-proxycmd "ssh -W %host:%port -o StrictHostKeyChecking=accept-new ${JUMP_TARGET}")
        fi
      else
        cmd+=(-load "$PUTTY_JUMP_SESSION")
      fi
    fi
    cmd+=("$ip")
    "${cmd[@]}" >/dev/null 2>&1 &
    sleep 0.15
  done
  echo "Launched ${#DEVICE_JSON_LINES[@]} PuTTY session(s)."
}

launch_native() {
  local force_wt="${1:-0}"
  # Offer vault autofill only when native ssh + sshpass are usable (not for the
  # wt/Windows-ssh path, which has no non-interactive password mechanism).
  if [[ "$force_wt" -ne 1 ]] && command -v sshpass >/dev/null 2>&1; then
    load_device_credentials
    [[ -n "$DEVICE_PASSWORD" ]] && echo "Device password autofill: enabled (sshpass)."
  fi
  local line name ip
  for line in "${DEVICE_JSON_LINES[@]}"; do
    name="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["short"])' "$line")"
    ip="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["ip"])' "$line")"
    launch_native_one "$name" "$ip" "$force_wt"
    sleep 0.15
  done
  echo "Launched ${#DEVICE_JSON_LINES[@]} native SSH session(s)."
}

launch_windows_shell() {
  local shell_kind="$1" # powershell | cmd
  local ps_exe cmd_exe
  ps_exe="$(command -v powershell.exe 2>/dev/null || command -v pwsh.exe 2>/dev/null || command -v pwsh 2>/dev/null || command -v powershell 2>/dev/null || true)"
  cmd_exe="$(command -v cmd.exe 2>/dev/null || true)"

  if [[ "$shell_kind" == "powershell" && -z "$ps_exe" ]]; then
    echo "PowerShell not found (powershell.exe / pwsh)." >&2
    exit 1
  fi
  if [[ "$shell_kind" == "cmd" && -z "$cmd_exe" ]]; then
    echo "cmd.exe not found (are you on Windows/WSL?)." >&2
    exit 1
  fi

  local line name ip ssh_cmd
  for line in "${DEVICE_JSON_LINES[@]}"; do
    name="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["short"])' "$line")"
    ip="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["ip"])' "$line")"
    # Windows ssh.exe cannot use a unix control socket — keep plain -J.
    ssh_cmd="$(ssh_argv_for "$ip" 0)"
    echo "→ ${name} (${ip}) via ${shell_kind}"
    if [[ "$shell_kind" == "powershell" ]]; then
      if [[ "$(basename "$ps_exe")" == "powershell.exe" || "$(basename "$ps_exe")" == "pwsh.exe" ]]; then
        "$ps_exe" -NoProfile -Command "Start-Process powershell -ArgumentList '-NoExit','-Command','${ssh_cmd//\'/\'\'}'" &
      else
        # Native pwsh on Linux/macOS: new window when possible, else current
        "$ps_exe" -NoExit -Command "$ssh_cmd" &
      fi
    else
      "$cmd_exe" /c start "clab:${name}" cmd /k "$ssh_cmd" &
    fi
    sleep 0.15
  done
  echo "Launched ${#DEVICE_JSON_LINES[@]} ${shell_kind} session(s)."
}

resolve_wireshark() {
  if [[ -n "$WIRESHARK_BIN" ]]; then
    return 0
  fi
  local c
  for c in wireshark \
    "/Applications/Wireshark.app/Contents/MacOS/Wireshark" \
    "/mnt/c/Program Files/Wireshark/wireshark.exe" \
    "/mnt/c/Program Files (x86)/Wireshark/wireshark.exe" \
    wireshark.exe; do
    if command -v "$c" >/dev/null 2>&1; then
      WIRESHARK_BIN="$(command -v "$c")"
      return 0
    fi
    if [[ -x "$c" ]]; then
      WIRESHARK_BIN="$c"
      return 0
    fi
  done
  echo "Wireshark not found. Install wireshark or set WIRESHARK_BIN / --wireshark." >&2
  exit 1
}

# Capture reuses the jump ControlMaster (no extra password) and always targets
# the clab host itself, where the node network namespaces live.
CAP_SSH_OPTS=()
CAP_SUDO_PW=""    # set only when interactive sudo is required
CAP_PRIV=""       # privilege prefix: "" | "sudo -n " | "sudo -S -p '' "

# Run a remote command on the clab host, quietly, returning its exit status.
cap_ssh_ok() {
  ssh "${CAP_SSH_OPTS[@]}" "$JUMP_TARGET" "$1" </dev/null >/dev/null 2>&1
}

# Run a remote command and stream its stdout. Feeds the sudo password on stdin
# (never argv) when interactive sudo is in use.
cap_run() {
  local remote="${CAP_PRIV}$1"
  if [[ -n "$CAP_SUDO_PW" ]]; then
    printf '%s\n' "$CAP_SUDO_PW" | ssh "${CAP_SSH_OPTS[@]}" "$JUMP_TARGET" "$remote"
  else
    ssh "${CAP_SSH_OPTS[@]}" "$JUMP_TARGET" "$remote" </dev/null
  fi
}

# Decide how to gain root on the clab host for a given operation. Sets CAP_PRIV
# (prefix to put before the privileged command) and CAP_SUDO_PW (when an
# interactive sudo password is needed). $1 = cheap remote test command, $2 =
# human label. Order: run directly (root login) → passwordless sudo → prompt.
determine_priv_for() {
  local test_cmd="$1" label="${2:-privileged commands}"
  CAP_PRIV=""
  CAP_SUDO_PW=""
  if [[ "$CAPTURE_SUDO" -eq 1 ]]; then
    read -r -s -p "sudo password for ${JUMP_TARGET}: " CAP_SUDO_PW
    echo
    CAP_PRIV="sudo -S -p '' "
    return 0
  fi
  if cap_ssh_ok "$test_cmd"; then
    CAP_PRIV=""
    return 0
  fi
  if cap_ssh_ok "sudo -n ${test_cmd}"; then
    CAP_PRIV="sudo -n "
    echo "Using passwordless sudo on ${CLAB_HOST}."
    return 0
  fi
  echo "Root is required for ${label} on ${CLAB_HOST}."
  read -r -s -p "sudo password for ${JUMP_TARGET}: " CAP_SUDO_PW
  echo
  CAP_PRIV="sudo -S -p '' "
  return 0
}

determine_capture_priv() {
  echo "Checking capture privileges on ${CLAB_HOST}..."
  determine_priv_for "ip netns exec $1 true" "'ip netns exec'"
}

launch_wireshark() {
  resolve_wireshark
  need ssh

  CAP_SSH_OPTS=(-o StrictHostKeyChecking=accept-new)
  if [[ -n "$CONTROL_PATH" && -S "$CONTROL_PATH" ]]; then
    CAP_SSH_OPTS+=(-o "ControlPath=${CONTROL_PATH}" -o ControlMaster=no)
  fi

  # Choose the node (netns = container long name). Prompt only when ambiguous.
  local cap_long cap_short line s l
  if [[ ${#DEVICE_JSON_LINES[@]} -eq 1 ]]; then
    cap_long="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["long"])' "${DEVICE_JSON_LINES[0]}")"
    cap_short="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["short"])' "${DEVICE_JSON_LINES[0]}")"
  else
    echo "Select a node to capture:"
    local i=1
    for line in "${DEVICE_JSON_LINES[@]}"; do
      s="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["short"])' "$line")"
      l="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["long"])' "$line")"
      printf "  %2d) %-16s %s\n" "$i" "$s" "$l"
      i=$((i + 1))
    done
    local sel
    read -r -p "Node number [1]: " sel
    sel="${sel:-1}"
    if ! [[ "$sel" =~ ^[0-9]+$ ]] || (( sel < 1 || sel > ${#DEVICE_JSON_LINES[@]} )); then
      echo "Invalid selection." >&2
      exit 1
    fi
    line="${DEVICE_JSON_LINES[$((sel - 1))]}"
    cap_long="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["long"])' "$line")"
    cap_short="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["short"])' "$line")"
  fi

  local cap_ns_q
  cap_ns_q="$(printf '%q' "$cap_long")"
  determine_capture_priv "$cap_ns_q"

  # Fetch the namespace's interfaces so we can validate / offer choices. Node
  # kinds name interfaces differently (SR Linux e1-1, vrnetlab/vJunos eth1,
  # Linux eth1...), so never assume — always check what actually exists.
  local names=() n ifaces
  if ifaces="$(cap_run "ip netns exec ${cap_ns_q} ip -br link" 2>/dev/null)"; then
    while IFS= read -r n; do
      n="${n%%[[:space:]]*}"   # first column
      n="${n%%@*}"             # strip @ifNN peer suffix
      [[ -z "$n" ]] && continue
      names+=("$n")
    done < <(printf '%s\n' "$ifaces")
  fi

  local iface="$CAPTURE_IFACE"
  # A requested interface that doesn't exist would dead-end in Wireshark
  # ("No such device"); catch it here and fall back to the real list.
  if [[ -n "$iface" && ${#names[@]} -gt 0 ]]; then
    local found=0
    for n in "${names[@]}"; do
      [[ "$n" == "$iface" ]] && found=1 && break
    done
    if [[ "$found" -eq 0 ]]; then
      echo "Interface '${iface}' not found on ${cap_short}." >&2
      iface=""
    fi
  fi
  if [[ -z "$iface" ]]; then
    if [[ ${#names[@]} -gt 0 ]]; then
      echo "Interfaces on ${cap_short} (${cap_long}):"
      for n in "${names[@]}"; do
        printf "   - %s\n" "$n"
      done
    else
      echo "Could not list interfaces on ${cap_short} (enter one manually)." >&2
      echo "  (need root for the namespace? re-run with --capture-sudo)" >&2
    fi
    read -r -p "Interface to capture: " iface
    iface="$(echo "$iface" | tr -d '[:space:]')"
  fi
  if [[ -z "$iface" ]]; then
    echo "No interface selected." >&2
    exit 1
  fi

  # Build the remote tcpdump: -U (unbuffered) -nn (no name resolution) -w - (pcap
  # to stdout). CAP_PRIV supplies root (sudo) when needed. Any BPF filter is
  # appended as a trailing expression.
  local if_q remote
  if_q="$(printf '%q' "$iface")"
  remote="${CAP_PRIV}ip netns exec ${cap_ns_q} tcpdump -U -nni ${if_q} -w -"
  if [[ -n "$CAPTURE_FILTER" ]]; then
    remote="${remote} ${CAPTURE_FILTER}"
  fi

  echo
  echo "Capturing ${cap_short} ${iface} on ${CLAB_HOST} → local Wireshark"
  echo "(no packets are re-transmitted; the pcap stream rides the SSH tunnel)"
  echo "Close Wireshark to stop the capture."

  # tcpdump writes libpcap to stdout over SSH; Wireshark reads it from stdin.
  # When interactive sudo is used, feed its password on stdin (never argv).
  if [[ -n "$CAP_SUDO_PW" ]]; then
    printf '%s\n' "$CAP_SUDO_PW" \
      | ssh "${CAP_SSH_OPTS[@]}" "$JUMP_TARGET" "$remote" \
      | "$WIRESHARK_BIN" -k -i - &
  else
    ssh "${CAP_SSH_OPTS[@]}" "$JUMP_TARGET" "$remote" \
      | "$WIRESHARK_BIN" -k -i - &
  fi
  local pid=$!
  disown "$pid" 2>/dev/null || true
  CAP_SUDO_PW=""
  sleep 1.0
  echo "Wireshark launched (pipeline pid $pid)."
}

open_url() {
  local u="$1"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$u" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    open "$u" >/dev/null 2>&1 &
  elif command -v wslview >/dev/null 2>&1; then
    wslview "$u" >/dev/null 2>&1 &
  elif command -v explorer.exe >/dev/null 2>&1; then
    explorer.exe "$u" >/dev/null 2>&1 &
  else
    echo "Open this URL in your browser: $u"
    return 0
  fi
  disown 2>/dev/null || true
}

# Edgeshark provides a web UI + Wireshark plugin backend on the clab host (port
# 5001, no auth). Rather than expose that port to the network, we forward it
# through the already-authenticated jump tunnel so the local cshargextcap plugin
# / packetflix:// handler can safely target localhost.
# Probe an HTTP endpoint; success = the server answered *anything* (any status),
# not just 2xx (Edgeshark's root may redirect). $2 = attempts, ~2s apart.
edgeshark_up() {
  local u="$1" tries="${2:-1}" i
  command -v curl >/dev/null 2>&1 || return 0
  for ((i = 1; i <= tries; i++)); do
    if curl -s -o /dev/null --max-time 4 "$u"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Deploy Edgeshark on the clab host via its official Docker Compose file. This
# is version-independent (older/newer containerlab may lack 'tools edgeshark').
edgeshark_install() {
  local compose_url="https://github.com/siemens/edgeshark/raw/main/deployments/wget/docker-compose.yaml"

  echo "Deploying Edgeshark on ${CLAB_HOST} via Docker Compose..."
  determine_priv_for "docker info" "docker"

  local ssh_opts=(-o StrictHostKeyChecking=accept-new)
  if [[ -n "$CONTROL_PATH" && -S "$CONTROL_PATH" ]]; then
    ssh_opts+=(-o "ControlPath=${CONTROL_PATH}" -o ControlMaster=no)
  fi

  # Fetch the compose file on the host, then bring the stack up detached. Only
  # the 'docker compose' call is privileged (CAP_PRIV); fetch/rm are not.
  local remote
  remote="f=\$(mktemp) && { curl -fsSL '${compose_url}' -o \"\$f\" || wget -qO \"\$f\" '${compose_url}'; } && DOCKER_DEFAULT_PLATFORM= ${CAP_PRIV}docker compose -f \"\$f\" up -d; rc=\$?; rm -f \"\$f\"; exit \$rc"

  if [[ -n "$CAP_SUDO_PW" ]]; then
    printf '%s\n' "$CAP_SUDO_PW" | ssh "${ssh_opts[@]}" "$JUMP_TARGET" "$remote"
  else
    ssh "${ssh_opts[@]}" "$JUMP_TARGET" "$remote" </dev/null
  fi
  local rc=$?
  CAP_SUDO_PW=""
  if [[ $rc -ne 0 ]]; then
    echo "Edgeshark deploy failed (exit $rc)." >&2
    echo "Deploy manually on ${CLAB_HOST}:" >&2
    echo "  curl -fsSL ${compose_url} | DOCKER_DEFAULT_PLATFORM= docker compose -f - up -d" >&2
    return 1
  fi
  echo "Edgeshark stack requested; waiting for it to come up..."
  return 0
}

# cshargextcap must live in a directory Wireshark scans for extcap plugins.
# Several distro packages install it to /usr/lib/<triplet>/wireshark/extcap, which
# Wireshark 4.6+ no longer scans, so the 'packetflix'/'mobyshark' interfaces never
# load. Wireshark then exits *instantly* when the packetflix:// handler passes
# `-o extcap.packetflix.url:...` ("unknown preference"), which looks like the
# capture window dying the moment it opens. Detect this and link the plugin into a
# directory Wireshark actually scans (personal dir first, no root; global as fallback).
check_extcap_plugin() {
  local have_tshark=0
  command -v tshark >/dev/null 2>&1 && have_tshark=1

  # Ground truth: if Wireshark already discovers packetflix, there's nothing to do.
  if [[ $have_tshark -eq 1 ]] && tshark -D 2>/dev/null | grep -qi 'packetflix'; then
    return 0
  fi

  # Locate the installed plugin binary in the common (mis)placed locations.
  local plug="" c
  for c in /usr/lib/*/wireshark/extcap/cshargextcap \
    /usr/lib/wireshark/extcap/cshargextcap \
    /usr/local/lib/*/wireshark/extcap/cshargextcap \
    /usr/local/lib/wireshark/extcap/cshargextcap; do
    [[ -x "$c" ]] && {
      plug="$c"
      break
    }
  done
  if [[ -z "$plug" ]]; then
    echo "Note: the cshargextcap Wireshark plugin isn't installed locally, so the" >&2
    echo "      Edgeshark 'Wireshark' button won't work. Install it from:" >&2
    echo "      https://github.com/siemens/cshargextcap/releases" >&2
    return 0
  fi

  local personal="$HOME/.local/lib/wireshark/extcap"
  echo "Wireshark isn't loading cshargextcap (it's in ${plug%/*}, which recent" >&2
  echo "Wireshark versions don't scan). Linking it into ${personal}..." >&2
  if mkdir -p "$personal" 2>/dev/null && ln -sf "$plug" "$personal/cshargextcap" 2>/dev/null; then
    if [[ $have_tshark -eq 1 ]]; then
      if tshark -D 2>/dev/null | grep -qi 'packetflix'; then
        echo "Fixed: Wireshark now sees the 'packetflix' capture interface." >&2
        return 0
      fi
      # Confirmed this build doesn't scan the personal dir; don't leave a dead link.
      rm -f "$personal/cshargextcap" 2>/dev/null
    else
      echo "Linked (best effort). Install 'tshark' to auto-verify, or check manually." >&2
    fi
  fi

  cat >&2 <<EOF
If the Wireshark button still dies on open, link the plugin into the global
extcap directory Wireshark scans (one-time, needs sudo):

  sudo ln -sf ${plug} /usr/libexec/wireshark/extcap/cshargextcap

Verify with:  tshark -D | grep packetflix
EOF
  return 0
}

launch_edgeshark() {
  need ssh
  local rport="${EDGESHARK_PORT:-5001}"
  local lport="${EDGESHARK_LOCAL_PORT:-$rport}"

  local ssh_opts=(-o StrictHostKeyChecking=accept-new)
  if [[ -n "$CONTROL_PATH" && -S "$CONTROL_PATH" ]]; then
    ssh_opts+=(-o "ControlPath=${CONTROL_PATH}" -o ControlMaster=no)
  fi

  local installed=0
  if [[ "$EDGESHARK_INSTALL" -eq 1 ]]; then
    edgeshark_install && installed=1
  fi

  local tries=2
  [[ "$installed" -eq 1 ]] && tries=15

  local direct_url="http://${CLAB_HOST}:${rport}"
  local url=""

  # Prefer a DIRECT connection to the host's Edgeshark port. It's simpler and,
  # crucially, the packetflix capture stream then works without depending on an
  # SSH port-forward carrying a WebSocket (which is where captures tend to die).
  # Only tunnel when the host port isn't directly reachable (or forced).
  if [[ "$EDGESHARK_TUNNEL" -ne 1 ]]; then
    if [[ "$EDGESHARK_DIRECT" -eq 1 ]] || [[ "$NO_JUMP" -eq 1 ]]; then
      url="$direct_url"
      echo "Direct mode: targeting ${url}."
    elif edgeshark_up "$direct_url" "$tries"; then
      url="$direct_url"
      echo "Edgeshark reachable directly at ${url} (no tunnel needed)."
    fi
  fi

  # Fall back to forwarding the port through the jump tunnel.
  if [[ -z "$url" ]]; then
    if [[ "$NO_JUMP" -eq 1 || -z "$CONTROL_PATH" || ! -S "$CONTROL_PATH" ]]; then
      echo "Edgeshark is not reachable at ${direct_url} and no jump tunnel is available." >&2
      echo "Deploy it (--edgeshark-install) or check the host/port." >&2
      exit 1
    fi
    echo "Host port not directly reachable; forwarding through the jump tunnel."
    if ! python3 -c 'import socket,sys
s=socket.socket()
try:
    s.bind(("127.0.0.1", int(sys.argv[1]))); s.close()
except OSError:
    sys.exit(1)' "$lport" 2>/dev/null; then
      lport="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    fi
    # Prefer a multiplexed session over the master (rides the existing auth) and
    # fall back to `-O forward` if that fails.
    if ! ssh -fN -o ControlMaster=no -S "$CONTROL_PATH" \
      -L "127.0.0.1:${lport}:127.0.0.1:${rport}" "$JUMP_TARGET" 2>/dev/null \
      && ! ssh -S "$CONTROL_PATH" -O forward \
        -L "127.0.0.1:${lport}:127.0.0.1:${rport}" "$JUMP_TARGET" 2>/dev/null; then
      echo "Could not set up the Edgeshark port-forward on the jump tunnel." >&2
      exit 1
    fi
    url="http://127.0.0.1:${lport}"
    echo "Edgeshark tunneled: ${url}  →  ${CLAB_HOST}:${rport} (via ${JUMP_TARGET})"
    if edgeshark_up "$url" "$tries"; then
      echo "Edgeshark UI is responding through the tunnel."
    else
      echo "Warning: no response from ${url} yet (it may still be starting)." >&2
    fi
  fi

  # Make sure the local Wireshark can actually see the packetflix/mobyshark
  # extcap before we point the user at the capture buttons.
  check_extcap_plugin

  if [[ "$EDGESHARK_NO_OPEN" -eq 0 ]]; then
    open_url "$url"
  fi

  local host_for_plugin="${url#http://}"
  cat <<EOF

Next steps:
  • In the Edgeshark web UI, find your node and click its Wireshark button, or
  • In Wireshark: 'Docker host capture' extcap → gear → Docker host URL: ${host_for_plugin}
  • One-time local setup (if not done): install the cshargextcap plugin +
    packetflix:// handler → https://github.com/siemens/cshargextcap/releases
    (verify Wireshark sees it with:  tshark -D | grep packetflix)

The forwarded port stays up with the jump tunnel and closes when it does.
EOF
}

echo "Launcher: ${LAUNCHER}"
echo "Device user: ${CLAB_USER}"
if [[ "$NO_JUMP" -eq 0 ]]; then
  echo "Jump host: ${JUMP_TARGET}"
else
  echo "Jump host: (none)"
fi
echo "Jump tunnel already opened (device passwords autofill for asbru; native/putty where supported)."
echo

case "$LAUNCHER" in
  asbru) launch_asbru ;;
  securecrt) launch_securecrt ;;
  putty) launch_putty ;;
  native) launch_native 0 ;;
  wt) launch_native 1 ;;
  powershell) launch_windows_shell powershell ;;
  cmd) launch_windows_shell cmd ;;
  wireshark|pcap) launch_wireshark ;;
  edgeshark) launch_edgeshark ;;
  *)
    echo "Unknown launcher: $LAUNCHER" >&2
    echo "Use: asbru|securecrt|putty|native|wt|powershell|cmd|wireshark|edgeshark" >&2
    echo "See: ./clab-ssh --list-launchers" >&2
    exit 1
    ;;
esac
